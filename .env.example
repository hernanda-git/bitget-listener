# Bitget credentials (USDⓈ-M futures). NEVER commit the real .env.
# Demo/testnet path: set BITGET_PRODUCT_TYPE=SUSDT-FUTURES and use SBTCSUSDT symbols.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_PRODUCT_TYPE=SUSDT-FUTURES
BITGET_REST_BASE=https://api.bitget.com
BITGET_WS_PUBLIC=wss://ws.bitget.com/v2/ws/public
BITGET_WS_PRIVATE=wss://ws.bitget.com/v2/ws/private

# Telegram signal source (Telethon user session)
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL=fattyfatclub

# Telegram notifier bot. Leave BOTH empty to disable alerts (the notifier then
# only logs "[notifier:no-credentials] ..." and you are blind unless you open the
# dashboard). TG_CHAT_ID is the destination chat; TG_OPERATOR_ID is the only id
# allowed to run state-changing commands (/toggle, /paper, /live, /close) and the
# router fails CLOSED when it is unset.
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_OPERATOR_ID=

# Postgres (reuses the existing fatty_config DB; no new server)
PGHOST=
PGPORT=5432
PGDATABASE=fatty_config
PGUSER=
PGPASSWORD=
BOT_NAME=bitget-listener

# Web dashboard
WEB_HOST=0.0.0.0
PORT=8092
DASH_PASSWORD=
